   "item": "10",
   "section": "Action Calendar – New Business",
   "heading": "Five-Year Street Rehabilitation and Measure FF Plans for Fiscal Years 2027- 2031",
   "lines": [
    317,
    343
   ],
   "from": "City Manager",
   "contact": "Wahid Amiri, Public Works, (510) 981-6300",
   "financial_implications": "See report",
   "action": "Action: 2 speakers. M/S/C (Humbert/Tregub) to adopt Resolution No. 72,377–N.S. adopting the Five-Year Street Rehabilitation Plan for Fiscal Years 2027-2031 and the Measure FF 5-Year CIP Plan for Fiscal Years 2027-2031 with the added clauses below. WHEREAS at its June 23, 2026 meeting Council identified the Vision Zero Phased Implementation Plan, Traffic Signal Master Plan, Transportation Fiber Optic Network, and Traffic Signal Modernization Project, and Transportation Nexus Study as unfunded needs requiring further review by the SAFE STREETS Citizen Oversight Committee (SSCOC) and City Council. THEREFORE BE IT RESOLVED that the Berkeley city Council directs staff to note the Vision Zero Phased Implementation Plan, Traffic Signal Master Plan, Transportation Fiber Optic Network, Traffic Signal Modernization Project, and Transportation Nexus Study are preliminary Measure FF Safety Projects and are subject to subsequent review and approval by the SAFE STREETS Citizen Oversight Committee (SSCOC) and the City Council; and Vote: All Ayes.",
   "speakers": 2,
   "attribution": [],
   "added_cosponsors": [],
   "motions": [
    {
     "seq": 0,
     "kind": "main",
     "movers": [
      {
       "member": "off-humbert",
       "as_printed": "Humbert"
      },
      {
       "member": "off-tregub",
       "as_printed": "Tregub"
      }
     ],
     "disposition": "carried",
     "severed": false,
     "final": true,
     "text": "adopt Resolution No. 72,377–N.S. adopting the Five-Year Street Rehabilitation Plan for Fiscal Years 2027-2031 and the Measure FF 5-Year CIP Plan for Fiscal Years 2027-2031 with the added clauses below. WHEREAS at its June 23, 2026 meeting Council identified the Vision Zero Phased Implementation Plan, Traffic Signal Master Plan, Transportation Fiber Optic Network, and Traffic Signal Modernization Project, and Transportation Nexus Study as unfunded needs requiring further review by the SAFE STREETS Citizen Oversight Committee (SSCOC) and City Council. THEREFORE BE IT RESOLVED that the Berkeley city Council directs staff to note the Vision Zero Phased Implementation Plan, Traffic Signal Master Plan, Transportation Fiber Optic Network, Traffic Signal Modernization Project, and Transportation Nexus Study are preliminary Measure FF Safety Projects and are subject to subsequent review and approval by the SAFE STREETS Citizen Oversight Committee (SSCOC) and the City Council; and",

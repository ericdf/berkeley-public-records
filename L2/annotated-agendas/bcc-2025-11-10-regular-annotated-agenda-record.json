   "item": "10",
   "section": "Action Calendar – New Business",
   "heading": "Adoption of and Amendments to the California Wildland-Urban Interface (WUI) Code",
   "lines": [
    271,
    301
   ],
   "from": "City Manager",
   "contact": "David Sprague, Fire, (510) 981-3473",
   "financial_implications": "See report",
   "action": "Action: 1 speaker. M/S/C (Blackaby/Ishii) to: 1. Adopt the first reading of Ordinance No. 7,991–N.S. Second reading scheduled for December 2, 2025. 2. Adopt Resolution No. 72,025–N.S. (Local Findings of Fact) 3. Thank the members of the WUI Vegetation Code Workgroup for their efforts, asking them to submit a memo with any additional follow-up recommendations to the Fire Chief before their work concludes on December 31, 2025. 4. Request that the City Manager bring back any additional WUI items coming out of these recommendations to the City Council’s Public Safety Policy Committee. 5. Within 60 days of the State Board of Forestry’s Zone Zero recommendation becoming finalized regulation, request that the City Manager report back to City Council with an update on the differences between the state and local vegetation management laws (if any). Vote: All Ayes. Recess: 7:14 p.m. – 7:27 p.m.",
   "speakers": 1,
   "attribution": [],
   "added_cosponsors": [],
   "motions": [
    {
     "seq": 0,
     "kind": "main",
     "movers": [
      {
       "member": "off-blackaby",
       "as_printed": "Blackaby"
      },
      {
       "member": "off-ishii",
       "as_printed": "Ishii"
      }
     ],
     "disposition": "carried",
     "severed": false,
     "final": true,
     "text": "1. Adopt the first reading of Ordinance No. 7,991–N.S. Second reading scheduled for December 2, 2025. 2. Adopt Resolution No. 72,025–N.S. (Local Findings of Fact) 3. Thank the members of the WUI Vegetation Code Workgroup for their efforts, asking them to submit a memo with any additional follow-up recommendations to the Fire Chief before their work concludes on December 31, 2025. 4. Request that the City Manager bring back any additional WUI items coming out of these recommendations to the City Council’s Public Safety Policy Committee. 5. Within 60 days of the State Board of Forestry’s Zone Zero recommendation becoming finalized regulation, request that the City Manager report back to City Council with an update on the differences between the state and local vegetation management laws (if any).",
     "vote_label": "vote",
     "vote": {
      "all_ayes": true,
      "ayes": [],
      "noes": [],
      "abstain": [],
      "absent": [],
